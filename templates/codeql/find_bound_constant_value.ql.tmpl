      (elemPos(ad) < elemPos(rm)) | ad.getLocation().getStartLine() < rm.getLocation().getStartLine()) and
    exists(int n, int r, MethodCall target |
      n = count(MethodCall ad | ad.getCallee().hasName("add") and
        ad.getQualifier().(VarAccess).getVariable() = v and (elemPos(ad) < elemPos(read))) and
      r = count(MethodCall rm | rm.getCallee().hasName("remove") and
        rm.getQualifier().(VarAccess).getVariable() = v and (elemPos(rm) < elemPos(read))) and
      slot + r < n and
      target.getCallee().hasName("add") and target.getQualifier().(VarAccess).getVariable() = v and
      (elemPos(target) < elemPos(read)) and
      count(MethodCall ad2 | ad2.getCallee().hasName("add") and
        ad2.getQualifier().(VarAccess).getVariable() = v and (elemPos(ad2) < elemPos(target))) = slot + r and
      certified_value_1(target.getArgument(0), value, _)))
