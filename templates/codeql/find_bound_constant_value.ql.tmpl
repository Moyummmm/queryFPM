predicate selectorIsConstant(Expr sel) {
  exists(int i | selectorIntValue(sel, i))
  or
  exists(string s | selectorStringValue(sel, s))
}

predicate selectorMatches(SwitchStmt sw, SwitchCase matched) {
  exists(int sv | selectorIntValue(sw.getExpr(), sv) |
    exists(ConstCase cc | cc = matched and constCaseHasInt(cc, sv)))
  or
  exists(string s | selectorStringValue(sw.getExpr(), s) |
    exists(ConstCase cc | cc = matched and constCaseHasString(cc, s))
    or
    (matched = sw.getDefaultCase() and
     not exists(ConstCase cc2 | cc2 = sw.getACase() and constCaseHasString(cc2, s))))
}

