predicate plainConstant(Expr e, string value) { value = e.(CompileTimeConstantExpr).getStringValue() }

predicate intConstant(Expr e, int value) { value = e.(CompileTimeConstantExpr).getIntValue() }

predicate collectionConstructor(Expr e) {
  exists(ConstructorCall cc | cc = e |
    cc.getNumArgument() = 0 and
    (cc.getCallee().getDeclaringType().getASupertype*().getSourceDeclaration().hasQualifiedName("java.util", "Collection") or
     cc.getCallee().getDeclaringType().getASupertype*().getSourceDeclaration().hasQualifiedName("java.util", "Map")))
}

predicate loopFree(Stmt s) { not exists(LoopStmt loop | loop.getAChild+() = s) }

predicate accessesConfined(LocalVariableDecl v, Expr exempt) {
  forall(VarAccess a | a.getVariable() = v |
    a = exempt or exempt.getAChildExpr*() = a or
    exists(MethodCall mc | mc.getQualifier() = a))
}

predicate simpleUpdate(Expr e, LocalVariableDecl v) {
  exists(AssignExpr a | e = a and a.getDest().(VarAccess).getVariable() = v)
  or
  exists(AssignOp op | e = op and op.getDest().(VarAccess).getVariable() = v)
}

predicate defExpr(LocalVariableDecl v, Expr rhs) {
  exists(LocalVariableDeclStmt ds, LocalVariableDeclExpr de |
    ds.getAVariable() = de and de.getVariable() = v and rhs = de.getInit())
  or
  exists(AssignExpr a | a.getDest().(VarAccess).getVariable() = v and rhs = a.getSource())
  or
  exists(AssignOp op | op.getDest().(VarAccess).getVariable() = v and rhs = op)
}

predicate constCaseHasInt(ConstCase cc, int sv) {
  exists(Expr v | v = cc.getValue(_) | intConstant(v, sv))
}

predicate caseStringValue(Expr v, string s) {
  v.(StringLiteral).getValue() = s
  or
  exists(string t | t = v.toString() and t.matches("'_'") and s = t.substring(1, 2))
}

predicate constCaseHasString(ConstCase cc, string s) {
  exists(Expr v | v = cc.getValue(_) | caseStringValue(v, s))
}

predicate selectorIntValue(Expr sel, int value) {
  intConstant(sel, value)
  or
  exists(VarAccess va | sel = va |
    exists(AssignExpr reset | reset.getDest() = va and selectorIntValue(reset.getSource(), value))
    or
    exists(LocalVariableDeclExpr de |
      de.getVariable() = va.getVariable().(LocalVariableDecl) and selectorIntValue(de.getInit(), value)))
}

predicate selectorStringValue(Expr sel, string s) {
  plainConstant(sel, s)
  or
  exists(MethodCall ca, string base, int idx |
    sel = ca and ca.getCallee().hasQualifiedName("java.lang", "String", "charAt") and
    intConstant(ca.getArgument(0), idx) and selectorStringValue(ca.getQualifier(), base) and
    s = base.substring(idx, idx + 1))
  or
  exists(VarAccess va | sel = va |
    exists(AssignExpr reset | reset.getDest() = va and selectorStringValue(reset.getSource(), s))
    or
    exists(LocalVariableDeclExpr de |
      de.getVariable() = va.getVariable().(LocalVariableDecl) and selectorStringValue(de.getInit(), s)))
