    loopFree(ds) and accessesConfined(v, read) and
    readStmt = read.getEnclosingStmt() and ds.getParent() = readStmt.getParent() and
    ds.getIndex() < readStmt.getIndex() and
    forall(ExprStmt es | es.getParent() = readStmt.getParent() and
      es.getIndex() > ds.getIndex() and es.getIndex() < readStmt.getIndex() and
      exists(VarAccess a | a.getVariable() = v and a.getEnclosingStmt() = es) |
      exists(MethodCall mc | mc.getEnclosingStmt() = es and mc.getQualifier().(VarAccess).getVariable() = v |
        mc.getCallee().hasName("add") or
        mc.getCallee().hasName("get") or
        exists(int zero | intConstant(mc.getArgument(0), zero) and mc.getCallee().hasName("remove") and zero = 0))) and
    forall(MethodCall rm, MethodCall ad |
      rm.getCallee().hasName("remove") and rm.getQualifier().(VarAccess).getVariable() = v and
