import java
import semmle.code.java.controlflow.Dominance

pragma[noinline]
predicate point(Expr expression, string file, int line, int column) {
  exists(Location loc |
    loc = expression.getLocation() and file = loc.getFile().getRelativePath() and
    line = loc.getStartLine() and column = loc.getStartColumn()
  )
}

// Ordering checks compare a single position integer (line * 100000 + column) from
// the elemPos function. A shared before/beforeStmt predicate was materialized by the
// evaluator as the full relation over expression pairs (quadratic on the benchmark
// database); inlined function calls evaluate per call site with both sides bound.
int elemPos(Element e) {
  result = e.getLocation().getStartLine() * 100000 + e.getLocation().getStartColumn()
}

predicate firstStringArgument(Call call, Expr value) {
  value = call.getAnArgument() and
  value.getType().(RefType).hasQualifiedName("java.lang", "String") and
  not exists(Expr earlier |
    earlier = call.getAnArgument() and earlier.getIndex() < value.getIndex() and
    earlier.getType().(RefType).hasQualifiedName("java.lang", "String"))
}

predicate dirContextReceiver(Call call) {
  call.getCallee().getDeclaringType().getASupertype*().getSourceDeclaration().hasQualifiedName("javax.naming.directory", "DirContext")
}

