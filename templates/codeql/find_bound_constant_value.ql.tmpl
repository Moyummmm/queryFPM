    v = c.getVariable().(LocalVariableDecl) and
    ds.getAVariable() = de and de.getVariable() = v and collectionConstructor(de.getInit()) and
    loopFree(ds) and accessesConfined(v, read) and
    readStmt = read.getEnclosingStmt() and ds.getParent() = readStmt.getParent() and
    ds.getIndex() < readStmt.getIndex() and
    forall(MethodCall put | put.getCallee().hasName("put") and
      put.getQualifier().(VarAccess).getVariable() = v and (elemPos(put) < elemPos(read)) |
      exists(string k | plainConstant(put.getArgument(0), k))) and
    forall(ExprStmt es | es.getParent() = readStmt.getParent() and
      es.getIndex() > ds.getIndex() and es.getIndex() < readStmt.getIndex() and
      exists(VarAccess a | a.getVariable() = v and a.getEnclosingStmt() = es) |
      exists(MethodCall mc | mc.getEnclosingStmt() = es and mc.getQualifier().(VarAccess).getVariable() = v |
        mc.getCallee().hasName("put") or mc.getCallee().hasName("get"))) and
    exists(MethodCall target |
      target.getCallee().hasName("put") and target.getQualifier().(VarAccess).getVariable() = v and
      (elemPos(target) < elemPos(read)) and plainConstant(target.getArgument(0), key) and
      not exists(MethodCall later | later.getCallee().hasName("put") and
        later.getQualifier().(VarAccess).getVariable() = v and
        (elemPos(target) < elemPos(later)) and (elemPos(later) < elemPos(read)) and
        plainConstant(later.getArgument(0), key)) and
      certified_value_9(target.getArgument(1), value, _)))
}

predicate aggregate_10(VarAccess va, string value) {
  exists(LocalVariableDecl v, LocalVariableDeclStmt ds, LocalVariableDeclExpr de |
    v = va.getVariable().(LocalVariableDecl) and
    ds.getAVariable() = de and de.getVariable() = v and
    loopFree(ds) and accessesConfined(v, va) and
    not exists(AssignExpr a | a.getDest().(VarAccess).getVariable() = v) and
    forall(MethodCall mc | mc.getQualifier().(VarAccess).getVariable() = v |
      mc.getCallee().hasName("add") and
      exists(string ev | certified_value_9(mc.getArgument(0), ev, _))) and
    (
      collectionConstructor(de.getInit())
      or
      exists(ArrayInit ai | ai = de.getInit() |
        forall(Expr el | el = ai.getAnInit() | exists(string ev | certified_value_9(el, ev, _))))
      or
      exists(ArrayCreationExpr ace | ace = de.getInit() |
        forall(Expr el | el = ace.getInit().getAnInit() | exists(string ev | certified_value_9(el, ev, _))))
    ) and
    value = "aggregate-constant")
}

predicate helper_returns_10(MethodCall mc, string value, string kind) {
  exists(Method m |
    m = mc.getMethod().getSourceDeclaration() and exists(m.getBody()) and
    exists(ReturnStmt r, Expr res, string v2, string k2 |
      r.getEnclosingCallable() = m and res = r.getExpr() and
      certified_value_9(res, v2, k2) and value = v2 and kind = k2) and
    forall(ReturnStmt r | r.getEnclosingCallable() = m |
      not exists(r.getExpr()) or
      exists(Expr res2, string v3, string k3 |
        res2 = r.getExpr() and certified_value_9(res2, v3, k3))))
}

from Call call, Expr value, string v, string kind, string proof
where valueAnchor(call, value)
  and certified_value_10(pragma[only_bind_into](value), v, kind)
  and kind != ""
  and kindProof(kind, proof)
  and (
    point(call, {{file}}, {{line}}, {{column}})
    or point(value, {{file}}, {{line}}, {{column}})
    or exists(Expr qualifier | qualifier = call.getQualifier() and point(qualifier, {{file}}, {{line}}, {{column}}))
  )
select "fpm-bound-v1", kind, {{cwe}}, {{file}}, {{line}}, {{column}},
  value.toString(), v, proof
